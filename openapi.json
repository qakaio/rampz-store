{
  "openapi": "3.1.0",
  "info": {
    "title": "Rampz Store Demo API",
    "version": "1.0.0",
    "description": "API contracts for endpoints currently implemented by the Rampz Store demo server. State is held in memory and reset on server restart."
  },
  "servers": [
    {
      "url": "/",
      "description": "Current origin"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Get service health",
        "responses": {
          "200": {
            "description": "Service is available",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Health" }
              }
            }
          },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" }
        }
      },
      "head": {
        "summary": "Check service health without a response body",
        "responses": {
          "200": { "description": "Service is available" }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "summary": "Get versioned service health",
        "responses": {
          "200": {
            "description": "Service is available",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Health" }
              }
            }
          },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" }
        }
      },
      "head": {
        "summary": "Check versioned service health without a response body",
        "responses": {
          "200": { "description": "Service is available" }
        }
      }
    },
    "/api/v1/categories": {
      "get": {
        "summary": "List seeded product categories",
        "responses": {
          "200": {
            "description": "Category names",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["data"],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": { "type": "string" }
                    }
                  }
                }
              }
            }
          },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" }
        }
      },
      "head": {
        "summary": "Check categories endpoint without a response body",
        "responses": {
          "200": { "description": "Categories endpoint is available" }
        }
      }
    },
    "/api/v1/products": {
      "get": {
        "summary": "Search and list products",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "Case-insensitive substring search in product name and category.",
            "schema": { "type": "string", "maxLength": 120 }
          },
          {
            "name": "category",
            "in": "query",
            "description": "Must exactly match a seeded category.",
            "schema": { "type": "string" }
          },
          {
            "name": "minPrice",
            "in": "query",
            "schema": { "type": "number", "minimum": 0 }
          },
          {
            "name": "maxPrice",
            "in": "query",
            "schema": { "type": "number", "minimum": 0 }
          },
          {
            "name": "inStock",
            "in": "query",
            "schema": { "type": "boolean" }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["featured", "price-asc", "price-desc", "name-asc", "newest"],
              "default": "featured"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": { "type": "integer", "minimum": 1, "maximum": 1000000, "default": 1 }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 12 }
          }
        ],
        "responses": {
          "200": {
            "description": "Product page and pagination metadata",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["data", "pagination"],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Product" }
                    },
                    "pagination": { "$ref": "#/components/schemas/Pagination" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" }
        }
      },
      "head": {
        "summary": "Check product listing endpoint without a response body",
        "responses": {
          "200": { "description": "Product listing endpoint is available" }
        }
      }
    },
    "/api/v1/openapi.json": {
      "get": {
        "summary": "Get the OpenAPI specification",
        "responses": {
          "200": {
            "description": "OpenAPI 3.1 document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["openapi", "info", "paths"],
                  "properties": {
                    "openapi": { "const": "3.1.0" },
                    "info": { "type": "object" },
                    "paths": { "type": "object" }
                  }
                }
              }
            }
          },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" }
        }
      },
      "head": {
        "summary": "Check OpenAPI specification availability without a response body",
        "responses": {
          "200": { "description": "Specification is available" }
        }
      }
    },
    "/api/v1/products/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": { "type": "integer", "minimum": 1 }
        }
      ],
      "get": {
        "summary": "Get one product",
        "responses": {
          "200": {
            "description": "Product details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["data"],
                  "properties": {
                    "data": { "$ref": "#/components/schemas/Product" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" }
        }
      },
      "head": {
        "summary": "Check product availability without a response body",
        "responses": {
          "200": { "description": "Product exists" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/v1/coupons/validate": {
      "post": {
        "summary": "Validate a demo coupon",
        "description": "Coupon eligibility is checked against the server's in-memory orders. This is demonstration behavior, not an authoritative checkout reservation. Write requests are limited to 60 per minute per client IP and endpoint.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["code", "subtotal", "email"],
                "additionalProperties": false,
                "properties": {
                  "code": { "type": "string", "minLength": 1, "maxLength": 40 },
                  "subtotal": { "type": "number", "minimum": 0, "maximum": 1000000 },
                  "email": { "type": "string", "format": "email", "maxLength": 254 }
                }
              },
              "example": { "code": "LAB20", "subtotal": 350, "email": "novo@rampz.test" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Coupon benefit",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["data"],
                  "properties": {
                    "data": { "$ref": "#/components/schemas/CouponBenefit" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" },
          "413": { "$ref": "#/components/responses/PayloadTooLarge" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" },
          "422": { "$ref": "#/components/responses/UnprocessableEntity" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/api/v1/shipping/calculate": {
      "post": {
        "summary": "Calculate a simulated shipping quote",
        "description": "Write requests are limited to 60 per minute per client IP and endpoint.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["cep", "subtotal"],
                "additionalProperties": false,
                "properties": {
                  "cep": { "type": "string", "pattern": "^\\d{5}-?\\d{3}$" },
                  "subtotal": { "type": "number", "minimum": 0, "maximum": 1000000 },
                  "coupon": { "type": "string" }
                }
              },
              "example": { "cep": "01310-000", "subtotal": 100 }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Simulated region, price and delivery estimate",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ShippingQuote" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" },
          "413": { "$ref": "#/components/responses/PayloadTooLarge" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" },
          "422": { "$ref": "#/components/responses/UnprocessableEntity" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/test/reset": {
      "post": {
        "summary": "Reset the in-memory seed in tests",
        "description": "Available only when NODE_ENV=test. This alias is retained for compatibility. Write requests are limited to 60 per minute per client IP and endpoint.",
        "responses": {
          "200": {
            "description": "Seed restored",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ResetResult" }
              }
            }
          },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/api/v1/test/reset": {
      "post": {
        "summary": "Reset the in-memory seed in tests",
        "description": "Available only when NODE_ENV=test. Write requests are limited to 60 per minute per client IP and endpoint.",
        "responses": {
          "200": {
            "description": "Seed restored",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ResetResult" }
              }
            }
          },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "required": ["status", "service", "environment", "uptimeSeconds"],
        "properties": {
          "status": { "const": "ok" },
          "service": { "const": "rampz-store" },
          "environment": { "type": "string" },
          "uptimeSeconds": { "type": "integer", "minimum": 0 }
        }
      },
      "Product": {
        "type": "object",
        "required": ["id", "name", "category", "price", "stock", "symbol", "description", "specifications"],
        "properties": {
          "id": { "type": "integer", "minimum": 1 },
          "name": { "type": "string" },
          "category": { "type": "string" },
          "price": { "type": "number", "minimum": 0, "description": "Price in Brazilian reais." },
          "stock": { "type": "integer", "minimum": 0 },
          "symbol": { "type": "string" },
          "description": { "type": "string" },
          "specifications": {
            "type": "object",
            "description": "Product-specific technical attributes. Values are display-ready strings.",
            "maxProperties": 12,
            "additionalProperties": { "type": "string", "maxLength": 160 }
          }
        }
      },
      "Pagination": {
        "type": "object",
        "required": ["page", "limit", "total", "totalPages"],
        "properties": {
          "page": { "type": "integer" },
          "limit": { "type": "integer" },
          "total": { "type": "integer" },
          "totalPages": { "type": "integer" }
        }
      },
      "CouponBenefit": {
        "type": "object",
        "required": ["code", "discount", "freeShipping"],
        "properties": {
          "code": { "type": "string", "enum": ["BEMVINDO10", "LAB20", "FRETEGRATIS"] },
          "discount": { "type": "number", "minimum": 0, "maximum": 1, "description": "Fractional discount, e.g. 0.1 for 10%." },
          "freeShipping": { "type": "boolean" }
        }
      },
      "ShippingQuote": {
        "type": "object",
        "required": ["cep", "region", "price", "days", "freeShipping"],
        "properties": {
          "cep": { "type": "string", "pattern": "^\\d{8}$" },
          "region": { "type": "string", "enum": ["South", "Southeast", "Other regions"] },
          "price": { "type": "number", "minimum": 0, "description": "Price in Brazilian reais." },
          "days": { "type": "integer", "minimum": 1 },
          "freeShipping": { "type": "boolean" }
        }
      },
      "ResetResult": {
        "type": "object",
        "required": ["status", "products", "users", "orders"],
        "properties": {
          "status": { "const": "reset" },
          "products": { "type": "integer" },
          "users": { "type": "integer" },
          "orders": { "type": "integer" }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": { "type": "string" }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Request is malformed or contains invalid values",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "NotFound": {
        "description": "Resource was not found",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "Forbidden": {
        "description": "Operation is not available in this environment",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "UnprocessableEntity": {
        "description": "Business rule rejected the request",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "MethodNotAllowed": {
        "description": "HTTP method is not supported for this endpoint",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "PayloadTooLarge": {
        "description": "JSON request body exceeds 16 KiB",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "UnsupportedMediaType": {
        "description": "Request Content-Type must be application/json",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "TooManyRequests": {
        "description": "Write request rate limit exceeded; retry after the indicated number of seconds",
        "headers": {
          "Retry-After": {
            "schema": { "type": "integer", "minimum": 1 }
          }
        },
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      }
    }
  }
}
